# =============================================================================
# Agent Framework - 环境变量配置模板
# =============================================================================
#
# 复制此文件为 .env 并填写实际值
# 所有 ${VAR} 格式的配置都会自动读取环境变量
#
# =============================================================================

# ── 模型 API Keys ─────────────────────────────────────────────────────────────

# 智谱 GLM
ZHIPU_API_KEY=your_zhipu_api_key

# OpenAI
OPENAI_API_KEY=sk-your_openai_api_key

# DeepSeek
DEEPSEEK_API_KEY=sk-your_deepseek_api_key

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# ── 微信渠道 ──────────────────────────────────────────────────────────────────

# 企业微信
WECHAT_CORP_ID=ww1234567890abcdef
WECHAT_AGENT_ID=1000001
WECHAT_CORP_SECRET=abc123def456...
WECHAT_TOKEN=my_token
WECHAT_ENCRYPT_KEY=abcdefghijklmnopqrstuvwxyz0123456789ABCDEFG

# 微信公众号
WECHAT_MP_APP_ID=wx1234567890abcdef
WECHAT_MP_APP_SECRET=abc123def456...
WECHAT_MP_TOKEN=my_mp_token
WECHAT_MP_ENCRYPT_KEY=abcdefghijklmnopqrstuvwxyz0123456789ABCDEFG

# ── 飞书/Lark 渠道 ─────────────────────────────────────────────────────────────

LARK_APP_ID=cli_a1b2c3d4e5f6g7h8
LARK_APP_SECRET=abc123def456...
LARK_ENCRYPT_KEY=abcdefghijklmnopqrstuvwxyz012345
LARK_VERIFY_TOKEN=my_verify_token

# 飞书群聊白名单（可选）
LARK_GROUP_ID_1=oc_xxxx
LARK_GROUP_ID_2=oc_yyyy

# ── 钉钉渠道 ──────────────────────────────────────────────────────────────────

DINGTALK_CLIENT_ID=ding123456789
DINGTALK_CLIENT_SECRET=abc123def456...
DINGTALK_AGENT_ID=123456
DINGTALK_TOKEN=my_token
DINGTALK_ENCRYPT_KEY=abcdefghijklmnopqrstuvwxyz012345

# ── Telegram 渠道 ─────────────────────────────────────────────────────────────

TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_WEBHOOK_URL=https://your-domain.com/telegram/webhook

# Telegram 允许的聊天 ID
TELEGRAM_CHAT_ID_1=123456789
TELEGRAM_CHAT_ID_2=-1001234567890

# ── Slack 渠道 ────────────────────────────────────────────────────────────────

SLACK_BOT_TOKEN=xoxb-123456789-abc123def456...
SLACK_APP_TOKEN=xapp-1-A123456789-abc123def456...
SLACK_SIGNING_SECRET=abc123def456789...

# ── Redis 配置（生产环境）──────────────────────────────────────────────────────

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── OpenViking 配置（上下文存储）───────────────────────────────────────────────

OPENVIKING_ENDPOINT=http://localhost:8080
OPENVIKING_API_KEY=your_openviking_api_key
OPENVIKING_WORKSPACE=/workspace/default

# ── 服务配置 ───────────────────────────────────────────────────────────────────

# 服务端口
SERVICE_PORT=8080

# 日志级别
LOG_LEVEL=info

# 环境
ENVIRONMENT=development
