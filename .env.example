# AgentFramework 多渠道机器人配置示例
#
# 复制此文件到 .env 并填入你的 API 凭证
# 命令: cp .env.example .env

# ============================================================================
# 国际渠道
# ============================================================================

# Telegram Bot Token
# 获取方式: 与 @BotFather 对话创建新机器人
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Discord Bot Token
# 获取方式: 访问 https://discord.com/developers/applications
DISCORD_BOT_TOKEN=MTIzNDU2Nzg5MA.GhIjKlMnOpQrStUvWxYz-ABC123DEF456

# Slack Bot Token
# 获取方式: 访问 https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-1234567890-1234-5678-9012-abcdefghijklmnopqrst
SLACK_APP_TOKEN=xapp-1-1234567890-1234-5678-9012-abcdefghijklmnopqrst

# ============================================================================
# 国内渠道
# ============================================================================

# 飞书 (Feishu/Lark)
# 获取方式: 访问 https://open.feishu.cn/app
FEISHU_APP_ID=cli_abc123def456
FEISHU_APP_SECRET=ABC123def456ghi789jkl012mno345pq

# 企业微信 (WeCom)
# 获取方式: 访问 https://work.weixin.qq.com/
WEWORK_CORP_ID=wwabc123def456
WEWORK_CORP_SECRET=abc123def456ghi789jkl012mno345pq
WEWORK_AGENT_ID=123456
WEWORK_TOKEN=your_callback_token
WEWORK_ENCODING_AES_KEY=abc123def456ghi789

# 钉钉 (DingTalk)
# 获取方式: 访问 https://open.dingtalk.com/
DINGTALK_APP_KEY=abc123def456ghi789
DINGTALK_APP_SECRET=ABC123def456ghi789jkl012mno345pq
DINGTALK_AGENT_ID=123456
DINGTALK_AGENT_SECRET=SECabc123def456
DINGTALK_ENCODING_AES_KEY=abc123def456ghi789jkl

# QQ (支持 OneBot 11 标准)
# 获取方式: 安装 go-cqhttp、NapCat 或 LLOneBot
QQ_BOT_ENABLED=true
QQ_BOT_API_BASE=http://127.0.0.1:3000
QQ_BOT_SELF_ID=123456789

# ============================================================================
# 高级配置
# ============================================================================

# 配置文件路径 (可选)
CHANNELS_CONFIG=config/channels.yaml

# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# 启用指标收集
ENABLE_METRICS=true

# 启用链路追踪
ENABLE_TRACING=true
